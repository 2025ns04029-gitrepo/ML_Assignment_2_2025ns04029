{
  "dataset": "Card Campaign Booking (Synthetic)",
  "source": "Synthetic data generated with seed 42",
  "features": [
    "is_credit_card",
    "is_debit_card",
    "is_prepaid_card",
    "card_tenure_months",
    "transactions_last_30d",
    "avg_transaction_inr_30d",
    "days_since_last_purchase",
    "offer_views_last_90d",
    "offer_bookings_last_90d",
    "travel_txns_last_90d",
    "dining_txns_last_90d",
    "historical_email_open_rate",
    "offered_discount_pct",
    "minimum_spend_inr",
    "offer_validity_days",
    "shown_on_weekend",
    "shown_in_app"
  ],
  "target": "booked_with_card_7d",
  "class_mapping": {
    "0": "no booking",
    "1": "booked"
  },
  "seed": 42,
  "train_rows": 1600,
  "test_rows": 400,
  "selected_by_training_cv_auc": "Logistic Regression",
  "python_version": "3.12.7",
  "package_versions": {
    "numpy": "2.5.4",
    "pandas": "2.2.3",
    "scikit-learn": "1.9.1",
    "scipy": "1.18.1",
    "matplotlib": "3.10.1",
    "joblib": "1.4.2"
  },
  "model_files": {
    "Logistic Regression": "logistic_regression.joblib",
    "Decision Tree": "decision_tree.joblib",
    "kNN": "knn.joblib",
    "Naive Bayes": "naive_bayes.joblib",
    "Support Vector Machine": "svm.joblib"
  }
}